    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/6e933da89b9a433ead7e3cdf031a95a3">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Mensajes retirados tras haber sido reportados</dct:title>
        <dct:description xml:lang="es">Este conjunto de datos recoge los contenidos de discurso de odio que han sido retirados por las plataformas tras haber sido reportados por el OBERAXE. Incluye información relativa a la respuesta de las plataformas ante los contenidos notificados, considerando las distintas vías y plazos de retirada, como retirada a las 24 horas, a las 48 horas, a la semana, limitación de visibilidad o retirada mediante vía cualificada de reporte.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/6e933da89b9a433ead7e3cdf031a95a3" />
        <dct:identifier>6E933DA8-9B9A-433E-AD7E-3CDF031A95A3</dct:identifier>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-14T11:33:11+00:00</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-14T11:33:11+00:00</dct:issued>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/sociedad-bienestar" />
        <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/SOCI" />
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC" />
        <dcat:distribution><dcat:Distribution rdf:about="https://10.99.193.1:8443/dataset/6e933da89b9a433ead7e3cdf031a95a3/resource/conjunto-datos-oberaxe-evolucion-mensajes-retirados">
    <dct:title xml:lang="es">Mensajes retirados tras haber sido reportados</dct:title>
    <dct:description xml:lang="es">Este conjunto de datos recoge los contenidos de discurso de odio que han sido retirados por las plataformas tras haber sido reportados por el OBERAXE. Incluye información relativa a la respuesta de las plataformas ante los contenidos notificados, considerando las distintas vías y plazos de retirada, como retirada a las 24 horas, a las 48 horas, a la semana, limitación de visibilidad o retirada mediante vía cualificada de reporte.</dct:description>
    <foaf:page rdf:resource="https://www.inclusion.gob.es/documents/d/oberaxe/nota-metodologica-sistema-faro" />
    <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0" />
