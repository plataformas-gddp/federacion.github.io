    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/6c7e3b5e10ca4b76ad22e855226a6f1a">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Evolución mensajes detectados</dct:title>
        <dct:description xml:lang="es">Este conjunto de datos muestra la evolución temporal de los mensajes detectados por el Sistema FARO durante el periodo de referencia. Permite observar la variación del volumen de contenidos identificados en redes sociales, detectar tendencias y picos de actividad, y relacionar la evolución del discurso de odio, del discurso odioso y de las narrativas discriminatorias con acontecimientos sociales, políticos, mediáticos o culturales.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/6c7e3b5e10ca4b76ad22e855226a6f1a" />
