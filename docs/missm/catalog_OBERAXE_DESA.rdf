    <dcat:dataset><dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/0698a7906cc042e29f93f686a0706216">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
    <dct:title xml:lang="es">Tipología del contenido del mensaje de discurso de odio</dct:title>
    <dct:description xml:lang="es">Este conjunto de datos clasifica los contenidos de discurso de odio según la tipología del mensaje dirigido contra el grupo diana. Recoge las principales formas de manifestación del discurso de odio, tales como presentar al grupo como una amenaza, deshumanizar o degradar, incitar a la expulsión del colectivo, incitar a la violencia, alabar o apoyar a quien atenta contra el grupo diana, o promover su descrédito por razón de su pertenencia al grupo.</dct:description>
    <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/0698a7906cc042e29f93f686a0706216" />
    <dct:identifier>0698A790-6CC0-42E2-9F93-F686A0706216</dct:identifier>
