    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/3bc07208c5fe44fbae7a15b28a5f7085">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Episodio que suscita el discurso de odio</dct:title>
        <dct:description xml:lang="es">Este conjunto de datos clasifica los contenidos de discurso de odio en función del episodio, acontecimiento o situación que suscita su aparición en redes sociales. Permite analizar los contextos sociales, políticos, culturales o mediáticos que actúan como catalizadores de expresiones hostiles, excluyentes o discriminatorias contra los grupos diana, así como identificar patrones recurrentes asociados a la agenda pública, la desinformación o las tendencias predominantes en redes.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/3bc07208c5fe44fbae7a15b28a5f7085" />
