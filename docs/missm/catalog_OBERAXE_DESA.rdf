    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/e0e55a26a71c42bc9d0bc5bd6c00fab0">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Expresión del lenguaje empleado en los mensajes de discurso de odio</dct:title>
        <dct:description xml:lang="es">Este conjunto de datos analiza las características del lenguaje utilizado en los mensajes de discurso de odio. Clasifica los contenidos según la forma en que se construye el mensaje, distinguiendo entre lenguaje agresivo explícito, lenguaje discriminatorio no agresivo e ironía o sarcasmo. Permite estudiar tanto las expresiones directas como las formas más veladas o encubiertas de difusión del discurso de odio en redes sociales.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/e0e55a26a71c42bc9d0bc5bd6c00fab0" />
