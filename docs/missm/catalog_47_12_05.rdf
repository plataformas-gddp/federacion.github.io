    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/7dcd595c03f643fca08483266966f107">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Afiliados Medios de la Seguridad Social en el Régimen General por CNAE 25 a dos dígitos, tipo de contrato y sexo (desde ene-26)</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que detalla el número medio de afiliados al sistema de la Seguridad Social en el Régimen General correspondiente al periodo de enero de 2026 (fecha de entrada en vigor del sistema de clasificación de actividades CNAE 2025) hasta la actualidad, solo para el Régimen General. La información está desagregada por tipo de contrato y jornada (Indefinido-Tiempo Completo, Indefinido-Tiempo Parcial, Temporal-Tiempo completo, etc.), código CNAE 2025 a dos dígitos y sexo (mujer y varón). Los datos incluyen totales generales y desgloses específicos por subcategorías.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/7dcd595c03f643fca08483266966f107" />
        <dct:identifier>7DCD595C-03F6-43FC-A084-83266966F107</dct:identifier>
        <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL" />
        <dcat:keyword xml:lang="es">Afiliados medios, Seguridad Social, Desglose por sexo, CNAE 2 dígitos, Tipo de contrato, Régimen General, Clasificación 2025, Estadísticas de empleo</dcat:keyword>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dct:modified>
