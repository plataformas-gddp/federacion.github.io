        <dcat:keyword xml:lang="es">Afiliados medios, Seguridad Social, Sector económico, Asalariados, Clasificación 2009, Clasificación 2025, Estadísticas de empleo</dcat:keyword>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-31</dct:modified>
