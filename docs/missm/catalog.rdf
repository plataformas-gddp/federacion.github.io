    <dcat:dataset><dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/9db8d07d2c334531933deaaff10b6e4d">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
    <dct:title xml:lang="es">Número de partes comunicados con baja/sin baja distribuidos por CNAE-09 (2 dígitos) y sexo.</dct:title>
    <dct:description xml:lang="es">Conjunto de datos estadístico que recoge el número de partes de enfermedad profesional comunicados en el sistema CEPROSS, clasificados según la actividad económica de la empresa conforme a la codificación CNAE‑09 a dos dígitos, desagregados por sexo de la persona trabajadora y por situación del parte (con baja, sin baja o total). La tabla permite la consulta por año y proporciona un desglose sectorial detallado del volumen de partes comunicados, siguiendo la estructura de variables publicada en el portal de estadísticas de la Seguridad Social.</dct:description>
    <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/9db8d07d2c334531933deaaff10b6e4d" />
    <dcat:landingPage rdf:resource="https://w6.seg-social.es/PXWeb_NCIP/pxweb/es/" />
    <dct:identifier>9db8d07d-2c33-4531-933d-eaaff10b6e4d</dct:identifier>
    <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL" />
    <dcat:keyword xml:lang="es">Enfermedades Profesionales, CEPROSS, Estadisticas Laborales</dcat:keyword>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-16</dct:modified>
