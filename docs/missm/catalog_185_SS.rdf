    <dcat:mediaType rdf:resource="http://www.iana.org/assignments/media-types/text/csv" />
    <dcat:accessURL rdf:resource="http://w6.seg-social.es/PXWeb_NCIP/sq/9165fd46-d85e-4eac-bbdb-0dfda1a23bfe" />
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-16</dct:modified>
