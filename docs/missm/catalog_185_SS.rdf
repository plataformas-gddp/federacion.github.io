        <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL" />
        <dcat:keyword xml:lang="es">Enfermedades Profesionales</dcat:keyword>
        <dcat:keyword xml:lang="es">CEPROSS</dcat:keyword>
        <dcat:keyword xml:lang="es">Estadisticas Laborales</dcat:keyword>
