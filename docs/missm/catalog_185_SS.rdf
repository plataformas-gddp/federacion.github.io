    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/eccbaad47b5e4458a6b1d0b739318afe">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Afiliados medios SS en RG por tipo contrato y jornada, edad y sexo</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que detalla el número medio de afiliados al sistema de la Seguridad Social en el Régimen General correspondiente al periodo de enero de 2012 hasta la actualidad. La información está desagregada por tipo de contrato y jornada (Indefinido-Tiempo Completo, Indefinido-Tiempo Parcial, Temporal-Tiempo completo, etc.), tramos de edad (en bloques de 5 años entre las 16 y los 64, con un tramo adicional para mayores de 64) y sexo (mujer y varón). Los datos incluyen totales generales y desgloses específicos por subcategorías.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/eccbaad47b5e4458a6b1d0b739318afe" />
        <dcat:landingPage rdf:resource="https://w6.seg-social.es/PXWeb/pxweb/es/Afiliados" />
        <dct:identifier>ECCBAAD4-7B5E-4458-A6B1-D0B739318AFE</dct:identifier>
        <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL" />
        <dcat:keyword xml:lang="es">Afiliados medios</dcat:keyword>
        <dcat:keyword xml:lang="es">Seguridad Social</dcat:keyword>
        <dcat:keyword xml:lang="es">Tramos de edad</dcat:keyword>
        <dcat:keyword xml:lang="es">Desglose por sexo</dcat:keyword>
        <dcat:keyword xml:lang="pt">Tipo de contrato</dcat:keyword>
        <dcat:keyword xml:lang="es">Régimen General</dcat:keyword>
        <dcat:keyword xml:lang="es">Estadísticas de empleo</dcat:keyword>
