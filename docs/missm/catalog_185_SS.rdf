        <dcat:keyword xml:lang="es">Altas medias</dcat:keyword>
        <dcat:keyword xml:lang="es">Bajas medias</dcat:keyword>
        <dcat:keyword xml:lang="es">Seguridad Social</dcat:keyword>
        <dcat:keyword xml:lang="es">Saldo afiliación</dcat:keyword>
        <dcat:keyword xml:lang="es">Régimen General</dcat:keyword>
