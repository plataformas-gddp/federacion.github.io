    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/a705281e152048e7991898eeeefe3188">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Número procesos por CCAA, edad y sexo</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadístico que recoge el número de procesos registrados en el sistema CEPROSS, clasificados por Comunidad Autónoma, grupo de edad de la persona trabajadora y sexo. La tabla permite la consulta por año y proporciona un desglose territorial y demográfico del volumen de procesos de enfermedad profesional gestionados, conforme a la estructura de variables publicada en el portal de estadísticas de la Seguridad Social.</dct:description>
