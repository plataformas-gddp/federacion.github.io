    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/d4a13298f6e14858a8412b32f840cfb1">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">Número partes cerrados EP con baja por grupo y agente EP y sexo</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadístico que recoge el número de partes de enfermedad profesional cerrados como enfermedad profesional con baja en el sistema CEPROSS, clasificados por grupo de enfermedad profesional y por agente causal asociado según la tipología establecida en el cuadro del Real Decreto 1299/2006, y desagregados por sexo de la persona trabajadora. La tabla permite la consulta por año y proporciona un desglose epidemiológico detallado que vincula cada expediente cerrado con baja con el agente específico dentro del grupo de enfermedad profesional correspondiente, conforme a la estructura de variables disponible en el portal de estadísticas de la Seguridad Social.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/d4a13298f6e14858a8412b32f840cfb1" />
        <dcat:landingPage rdf:resource="https://w6.seg-social.es/PXWeb_NCIP/pxweb/es/" />
        <dct:identifier>d4a13298-f6e1-4858-a841-2b32f840cfb1</dct:identifier>
        <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL" />
        <dcat:keyword xml:lang="es">Enfermedades Profesionales</dcat:keyword>
        <dcat:keyword xml:lang="es">CEPROSS</dcat:keyword>
        <dcat:keyword xml:lang="es">Estadisticas Laborales</dcat:keyword>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-16</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-16</dct:issued>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA" />
        <foaf:page rdf:resource="https://w6.seg-social.es/PXWeb_NCIP/Resources/Fuentes%20y%20nota%20explicativa.htm" />
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/salud" />
        <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/HEAL" />
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="Nf4e610ad89e64ca69fe5d0a8ff8fd923">
