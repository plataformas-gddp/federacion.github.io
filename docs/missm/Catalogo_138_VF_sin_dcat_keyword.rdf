    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/b17e6b3a6efc43f7a6a7764618d53c1a">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Afiliados extranjeros por sexo, provincia, régimen y origen (UE/No UE)</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que recoge la afiliación de personas extranjeras al sistema de la Seguridad Social a fin de mes, correspondiente al periodo desde enero de 2012 hasta la actualidad. La información está desagregada por sexo, provincia, régimen y origen (UE/No UE), permitiendo analizar la distribución territorial y administrativa de la afiliación extranjera.</dct:description>
