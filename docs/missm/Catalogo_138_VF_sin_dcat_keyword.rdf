    <dcat:dataset><dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/6116046bd691433aafe6b082a4055ba8">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title xml:lang="es">Cotizantes al último día del mes por provincia, comunidad autónoma, régimen y saldo de altas-bajas</dct:title>
    <dct:description xml:lang="es">Conjunto de datos estadísticos que recoge el número de códigos de cuenta de cotización a último día del mes, correspondiente al periodo comprendido entre enero de 2006 y marzo de 2020. La información está desagregada por provincia, comunidad autónoma, régimen y saldo de altas-bajas, permitiendo analizar la evolución territorial y por régimen de los movimientos CCC's.</dct:description>
    <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/6116046bd691433aafe6b082a4055ba8"/>
