    <dcat:dataset><dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/08504d2029f44f7aad96056b7ff2b7b9">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title xml:lang="es">Cotizantes medios en el Régimen General por actividad económica</dct:title>
    <dct:description xml:lang="es">Conjunto de datos estadísticos que recoge el número medio de códigos de cuenta de cotización en el Régimen General, correspondiente al periodo comprendido entre enero de 2009 y diciembre de 2025. La información está desagregada por actividad económica, permitiendo analizar la distribución de los CCC'S medios por rama de actividad.</dct:description>
