    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/293b3c050ec5429e990764ec7e6cb3af">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Cotizantes y base media de cotización por sexo y grupo de cotización</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que recoge información sobre cotizantes y base media de cotización, correspondiente al periodo comprendido desde enero de 2018 y hasta la actualidad. La información está desagregada por sexo y grupo de cotización, permitiendo analizar la distribución de los cotizantes y de la base media de cotización según grupo profesional de cotización.</dct:description>
