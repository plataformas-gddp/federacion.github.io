        <dct:identifier>904C3CC1-CC3F-4324-8375-E37EA31C2269</dct:identifier>
        <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dct:modified>
