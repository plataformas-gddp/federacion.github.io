    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/26ebb6170c2142b48a5fa1a836152d55">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Afiliados Medios de la Seguridad Social por provincia, edad y sexo</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que detalla el número medio de afiliados al sistema de la Seguridad Social correspondiente al periodo de enero de 2012 hasta la actualidad. La información está desagregada por tramos de edad (en bloques de 5 años entre las 16 y los 64, con un tramo adicional para mayores de 64), provincia y sexo (mujer y varón). Los datos incluyen totales generales y desgloses específicos por subcategorías.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/26ebb6170c2142b48a5fa1a836152d55"/>
        <dcat:landingPage rdf:resource="https://w6.seg-social.es/PXWeb/pxweb/es/Afiliadosenaltalaboral/Afiliadosenaltalaboral__AfiliadosMedios/11m.Porprovincia,edadysexo.px/"/>
        <dct:identifier>26EBB617-0C21-42B4-8A5F-A1A836152D55</dct:identifier>
        <dct:type rdf:resource="http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-31</dct:modified>
