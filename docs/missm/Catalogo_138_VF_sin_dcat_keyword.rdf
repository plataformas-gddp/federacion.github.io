        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Datos de cotizantes y días de cotización</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que recoge información sobre cotizantes y días de cotización, correspondiente al periodo comprendido entre enero de 2019 y diciembre de 2025. El conjunto permite analizar conjuntamente el número de cotizantes y los días cotizados en el periodo de referencia.</dct:description>
        <dcat:landingPage rdf:resource="https://10.99.193.1:8443/dataset/543a633b8012416fb62d58bbfc755278"/>
