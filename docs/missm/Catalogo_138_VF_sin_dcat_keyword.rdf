    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/74cc44652c0c45afbcd5b5214c735750">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Afiliados Medios de la Seguridad Social empleados públicos por provincia, ámbito territorial, y sexo</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que detalla el número medio de afiliados al sistema de la Seguridad Social correspondiente al periodo de enero de 2026 hasta la actualidad. La información está desagregada por provincia, ámbito territorial(autonómico, estatal y local) y sexo (mujer y varón). Los datos incluyen totales generales y desgloses específicos por subcategorías.</dct:description>
