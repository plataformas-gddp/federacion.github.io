    <dcat:dataset>
      <dcat:Dataset rdf:about="https://10.99.193.1:8443/dataset/93b78bf0e9894786bc86eec50a04c557">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Afiliados Medios de la Seguridad Social por sexo, edad y régimen</dct:title>
        <dct:description xml:lang="es">Conjunto de datos estadísticos que detalla el número medio de afiliados al sistema de la Seguridad Social correspondiente al periodo de enero de 2012 hasta la actualidad. La información está desagregada por tramos de edad (en bloques de 5 años entre las 16 y los 64, con un tramo adicional para mayores de 64), régimen (Régimen General, Especial de Trabajadores Autónomos, etc.) y sexo (mujer y varón). Los datos incluyen totales generales y desgloses específicos por subcategorías.</dct:description>
