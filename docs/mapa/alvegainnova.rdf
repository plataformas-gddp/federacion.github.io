          <vcard:Organization rdf:nodeID="Nc24dd74e335542fb825a21cd71fc7ed1">
            <vcard:fn>Ministerio de Agricultura, Pesca y Alimentación</vcard:fn>
          </vcard:Organization>
        </dcat:contactPoint>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="Nf421a20844a84229b08c7dadf7bef020">
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2027-10-01T00:00:00</dcat:endDate>
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-11-17T00:00:00</dcat:startDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:description xml:lang="en">Este dataset pertenece al Piloto Agrivoltaica que se trata de monitorizar distintos parámetros agroclimáticos de 2 explotaciones agrivoltaicas comparando valores de los cultivos en distintas posiciones para ver como afectan las placas - Este dataset contiene información medida con un dispositivo portatil de medición de calidad de aire. Este dataset contiene información sobre nivel de clorofila (adimensional), concentración de flavonoides (adimensional), balance de nitrógeno (adimensional), temperatura ambiental (°C), proveedor/generador del dato, nombre del sensor, modelo del equipo, identificador de estación, marca temporal del dato.</dct:description>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-21T11:40:41.875619</dct:modified>
