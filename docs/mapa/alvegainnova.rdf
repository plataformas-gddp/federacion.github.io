        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-01T21:48:57Z</dct:issued>
        <dct:description xml:lang="en">Este dataset pertenece al Agrolab Fertilización Inteligente que se trata de generar prescripciones de fertilizante basadas en estudios fisicoquimicos y de conductividad en varias de las parcelas perteneciente al CENCA. Este dataset incluye datos sobre las prescripciones de fertilizante incluyendo nutrientes aplicados como nitrógeno, fósforo y potasio, junto con información sobre la fecha de muestreo, identificadores de entidad y parcelas agrícolas, y detalles de cada lote.</dct:description>
        <dcat:keyword xml:lang="es">agricultura</dcat:keyword>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
