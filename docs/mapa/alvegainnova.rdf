        <dct:title xml:lang="es">Smart Pivot - Datos de riego y consumo de agua</dct:title>
        <dct:title xml:lang="en">Smart Pivot - Datos de riego y consumo de agua</dct:title>
        <dcat:contactPoint>
          <vcard:Organization rdf:nodeID="N1e9e33b7cfd3466795ccc95f64cf23cf">
