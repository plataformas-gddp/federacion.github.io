    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/3e0313e1-bac8-4d5e-aa02-35f37d33907e">
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-01T21:31:04Z</dct:issued>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/3e0313e1-bac8-4d5e-aa02-35f37d33907e/resource/e1e2fc7e-2f9c-4156-a8ea-5887bc1513de"/>
        <dcat:contactPoint rdf:resource="https://opendata.lavegainnova.es/contact/3e0313e1-bac8-4d5e-aa02-35f37d33907e"/>
        <dct:title xml:lang="en">Smart Pivot - Parámetros de cultivo</dct:title>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/3e0313e1-bac8-4d5e-aa02-35f37d33907e</dct:identifier>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-26T08:54:36Z</dct:modified>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:description xml:lang="es">Este dataset pertenece al piloto Smartpivot que se trata de generar recomendaciones de riego basadas en sensores de humedad, Estaciones meteorológicas cercanas e imágenes satelitales de NDVI en la parcela circular perteneciente al CENCA. Este dataset abarca parámetros de cultivo como coeficientes de  riego y su eficiencia, índice de estrés hídrico, tipo de suelo, tipo de cultivo, sistema de riego y referencias climáticas, además de información descriptiva del cultivo.</dct:description>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:title xml:lang="es">Smart Pivot - Parámetros de cultivo</dct:title>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N57d3122c57bf43b0ba744c3b66a9cbd3">
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-31</dcat:endDate>
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</dcat:startDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dcat:keyword xml:lang="es">agricultura</dcat:keyword>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:description xml:lang="en">Este dataset pertenece al piloto Smartpivot que se trata de generar recomendaciones de riego basadas en sensores de humedad, Estaciones meteorológicas cercanas e imágenes satelitales de NDVI en la parcela circular perteneciente al CENCA. Este dataset abarca parámetros de cultivo como coeficientes de  riego y su eficiencia, índice de estrés hídrico, tipo de suelo, tipo de cultivo, sistema de riego y referencias climáticas, además de información descriptiva del cultivo.</dct:description>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/3a587a0e-b7bb-44b0-b675-9203c6a17cd0">
        <dct:title xml:lang="en">Monitorización de silos - Silos</dct:title>
        <dcat:contactPoint rdf:resource="https://opendata.lavegainnova.es/contact/3a587a0e-b7bb-44b0-b675-9203c6a17cd0"/>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N1e0a79dfb9004cf48211c88d60d21bba">
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-10-01</dcat:endDate>
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-18</dcat:startDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-24T07:52:14Z</dct:issued>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:title xml:lang="es">Monitorización de silos - Silos</dct:title>
        <dct:description xml:lang="es">Este dataset pertenece al Agrolab monitorización de silos y comederos que se trata de monitorizar distintos parámetros de estado de los silos y comederos asociados a distintas explotaciones ganaderas usando sensores y cámaras. Este dataset contiene información sobre los silos, incluyendo registros como temperatura interna y externa (ºC), humedad interna (%), nivel porcentual (%) y nivel en kilogramos del depósito (Kg), junto con información administrativa como id de entidad y tipo de entidad entre otros.</dct:description>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dcat:keyword xml:lang="es">ganadería</dcat:keyword>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/3a587a0e-b7bb-44b0-b675-9203c6a17cd0</dct:identifier>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/3a587a0e-b7bb-44b0-b675-9203c6a17cd0/resource/9537950a-53f6-4560-8609-61a5c18ab8b0"/>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:description xml:lang="en">Este dataset pertenece al Agrolab monitorización de silos y comederos que se trata de monitorizar distintos parámetros de estado de los silos y comederos asociados a distintas explotaciones ganaderas usando sensores y cámaras. Este dataset contiene información sobre los silos, incluyendo registros como temperatura interna y externa (ºC), humedad interna (%), nivel porcentual (%) y nivel en kilogramos del depósito (Kg), junto con información administrativa como id de entidad y tipo de entidad entre otros.</dct:description>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-26T08:52:22Z</dct:modified>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3">
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-26T08:48:07Z</dct:modified>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:description xml:lang="es">Este dataset pertenece al piloto estimación de rendimiento que se trata de estimar el rendimiento de 4 explotaciones agrarias de olivar situadas en varios puntos de España. Estas estimaciones se han llevado a partir de datos históricos climáticos, satelitales, de producción y otros. Este dataset recopila datos meteorológicos y ambientales, índices de vegetación y teledetección y estimación de producción agrícola y muestra los datos históricos de proyecto.</dct:description>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3/resource/57198cc8-bd4c-4d3b-890c-e45992637c73"/>
