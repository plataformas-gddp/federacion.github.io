  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/2a4f788d-49f4-402d-8acc-9600ab7c0fec">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece al piloto Smartpivot que se trata de generar recomendaciones de riego basadas en sensores de humedad, Estaciones meteorológicas cercanas e imágenes satelitales de NDVI en la parcela circular perteneciente al CENCA. Este dataset contiene parámetros relacionados con el riego, como el tiempo y cantidad de riego, consumo de agua, referencias a parcelas agrícolas y datos de identificación, además de información descriptiva.</dc:description>
    <dc:identifier>2a4f788d-49f4-402d-8acc-9600ab7c0fec</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-01</dc:issued>
