  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/7bc1d2c8-bb52-4af0-ab01-9fab31d52ac3">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece a un proyecto independiente de dispositivos que se encuentran instalados en la Finca Experimental de Rabanales de la Universidad de Córdoba. La tecnología de comunicación es LORAWAN. Este dataset recopila datos ambientales, como humedad relativa, temperatura y nivel de batería, junto con detalles de la entidad, como su nombre, descripción y ruta de servicio. Datos cedidos a La Vega Innova por lua Universidad de Córdoba.</dc:description>
    <dc:identifier>7bc1d2c8-bb52-4af0-ab01-9fab31d52ac3</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-02</dc:issued>
