      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/ab4e4ec0-a25f-46cf-95d8-dc6886fa16e4">
        <dct:title xml:lang="en">Agrivoltaica - Monitorización de planta (dispositivo portátil)</dct:title>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/ab4e4ec0-a25f-46cf-95d8-dc6886fa16e4/resource/f87a3a68-63f4-4004-8700-944b26a8c80d"/>
