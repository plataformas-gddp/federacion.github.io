    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/f0419444-1c20-4b04-852b-63cec138f1b9">
        <dct:description xml:lang="es">Este dataset pertenece al Piloto monitorización de colmenas inteligentes desarrollado por la empresa Beeguard. Los datos generados provienen de la sensórica desplegada en 10 colmenas en diferentes explotaciones apícolas y de estaciones meteorológicas desplegadas cercanas. Este dataset contiene información sobre los datos internos de las colmenas con registros de temperatura (ºC), humedad(%), peso(Kg), conteo de entradas y salidas, junto con información administrativa como id de entidad y tipo de entidad entre otros.</dct:description>
        <dct:title xml:lang="es">Colmenas inteligentes - Datos interno de colmenas</dct:title>
        <dcat:keyword xml:lang="es">apicultura</dcat:keyword>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
