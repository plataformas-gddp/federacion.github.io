        <dct:title xml:lang="en">Agrivoltaica - Calidad del aire (dispositivo portátil)</dct:title>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/b5bef713-a64e-4bc8-a4f3-bbdbda063a64/resource/94cc02f7-4ff9-4ffa-9446-a5f4a11ade14"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:title xml:lang="es">Agrivoltaica - Calidad del aire (dispositivo portátil)</dct:title>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:description xml:lang="en">Este dataset pertenece al Piloto Agrivoltaica que se trata de monitorizar distintos parámetros agroclimáticos de 2 explotaciones agrivoltaicas comparando valores de los cultivos en distintas posiciones para ver como afectan las placas - Este dataset contiene información medida con un dispositivo portatil de medición de nutrición de cultivo. Este dataset contiene información sobre concentración de CO₂ (ppm), concentración de formaldehído HCHO (mg/m³), humedad relativa (%), concentración de PM10 (µg/m³), concentración de PM2.5 (µg/m³), número de partículas (partículas/L), temperatura ambiente (°C) y nombre del sensor entre otros.</dct:description>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-24T07:43:10.355577</dct:issued>
