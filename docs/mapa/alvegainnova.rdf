  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/1da2aaa5-892b-4fe2-bca9-48e83c3fbcc9">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece a un proyecto independiente de dispositivos que se encuentran instalados en la Finca Experimental de Rabanales de la Universidad de Córdoba. Este dataset abarca datos meteorológicos y de condiciones ambientales, como humedad, temperatura, viento, radiación solar, y riesgo de heladas, además de información de batería y referencias a parcelas agrícolas. Datos cedidos a La Vega Innova por la Universidad de Córdoba.</dc:description>
    <dc:identifier>1da2aaa5-892b-4fe2-bca9-48e83c3fbcc9</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-01</dc:issued>
    <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-02</dc:modified>
    <dc:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
    <dc:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/>
