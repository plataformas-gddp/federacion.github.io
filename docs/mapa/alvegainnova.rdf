        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3/resource/57198cc8-bd4c-4d3b-890c-e45992637c73"/>
        <dcat:keyword>agricultura</dcat:keyword>
        <dct:title xml:lang="en">Estimación de Rendimiento - Histórico Agroclimático y Productivo Olivar</dct:title>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N164292f2b08d401ab84e1a9a7a7a978a">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-01-01T00:00:00</dcat:startDate>
