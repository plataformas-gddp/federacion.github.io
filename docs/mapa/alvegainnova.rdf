  <dcat:Distribution rdf:about="https://opendata.lavegainnova.es/dataset/502147ac-35d6-4a29-97b0-d783b85ace03/resource/dd8c230b-ea3b-48dc-8f14-740deb4a6ff6">
    <dct:title xml:lang="es">AgroIrrigationObserved</dct:title>
    <dcat:mediaType>text/csv</dcat:mediaType>
    <dct:format>CSV</dct:format>
    <dcat:accessURL rdf:resource="https://bi.iotplatform.telefonica.com/pentaho/plugin/cda/api/doQuery?path=/public/ihub_mapa/verticals/agrovid/sql/agroirrigationobserved_historic_join.cda&amp;dataAccessId=agrovid_agroirrigationobserved_historic_join&amp;paramentityid=&amp;paramstart=&amp;paramfinish=&amp;_TRUST_USER_=opendata_ihub_mapa&amp;outputType=csv"/>
    <dct:title xml:lang="en">AgroIrrigationObserved</dct:title>
    <dcatap:availability rdf:resource="http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"/>
    <dct:description>Este dataset pertenece al Agrolab Smartagrovid que se trata de monitorizar distintos parámetros agroclimáticos en el cultivo de la vid con con dispositivos de 3 empresas distintas, Cesens, Metos y Libelium en dos viñas situadas una en la provincia de Madrid y otra en la provincia de Cádiz - Este dataset se ha construido con los datos provenientes de Libelium y contiene datos de humedad (expresada en %), temperatura (en °C) y salinidad (en dS/m) del suelo en 8 niveles cada 10 cm (de 0 a 80 cm). Concretamente, r_32_msd* representa la humedad con salinidad (%), r_32_sd* la salinidad (dS/m), r_32_td* la temperatura (°C), y r_32_mwosd* la humedad sin salinidad (%).</dct:description>
  </dcat:Distribution>
