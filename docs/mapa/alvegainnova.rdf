  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/3422e507-6394-4235-9cf4-187cb04ddf31">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece al Agrolab Fertilización Inteligente que se trata de generar prescripciones de fertilizante basadas en estudios fisicoquimicos y de conductividad en varias de las parcelas perteneciente al CENCA. Este dataset incluye datos sobre las prescripciones de fertilizante incluyendo nutrientes aplicados como nitrógeno, fósforo y potasio, junto con información sobre la fecha de muestreo, identificadores de entidad y parcelas agrícolas, y detalles de cada lote.</dc:description>
    <dc:identifier>3422e507-6394-4235-9cf4-187cb04ddf31</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-01</dc:issued>
    <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-02</dc:modified>
    <dc:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
    <dc:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/>
