        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-02T08:07:58.098247</dct:modified>
        <dct:description xml:lang="en">Este dataset pertenece a un proyecto independiente de dispositivos que se encuentran instalados en la Finca Experimental de Rabanales de la Universidad de Córdoba. La tecnología de comunicación es LORAWAN. Este dataset contiene datos sobre las condiciones del suelo, incluyendo humedad, temperatura y conductividad eléctrica, junto con la profundidad de medición y detalles de la entidad, como su nombre, descripción y ruta de servicio. Datos cedidos a La Vega Innova por lua Universidad de Córdoba.</dct:description>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/da8e6f5e-3c8b-4672-ac98-709af0ae65ec/resource/dd1dbd66-212e-4b27-be34-a9d4fe685284"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
