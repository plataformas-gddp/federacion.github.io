    <dcatap:availability rdf:resource="http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"/>
    <dct:description>Este dataset pertenece al Piloto Agrivoltaica que se trata de monitorizar distintos parámetros agroclimáticos de 2 explotaciones agrivoltaicas comparando valores de los cultivos en distintas posiciones para ver como afectan las placas - Este dataset contiene información sobre precipitación (l/m^2), pluviómetro(n - número de pasos/pulsos), humedad relativa (0-1), temperatura (ºC), dirección del viento (0-360º), velocidad del viento (km/h), radiación solar (W/m^2), radiación solar PAR, evapotranspiración (mm), tiempo de mojado foliar (min) y presión (hPa) entre otros.</dct:description>
    <dcat:accessURL rdf:resource="https://bi.iotplatform.telefonica.com/pentaho/plugin/cda/api/doQuery?path=/public/ihub_mapa/verticals/agrovoltaic/sql/agroweatherobserved_historic_join.cda&amp;dataAccessId=agrovoltaic_agroweatherobserved_historic_join&amp;paramentityid=&amp;paramstart=&amp;paramfinish=&amp;_TRUST_USER_=opendata_ihub_mapa&amp;outputType=csv"/>
