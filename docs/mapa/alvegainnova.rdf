        <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</dcat:startDate>
      </dc:PeriodOfTime>
    </dc:temporal>

    <dc:title xml:lang="es">Smart Pivot - Datos meteorológicos observados</dc:title>
