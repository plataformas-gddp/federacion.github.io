        <dct:title xml:lang="en">Bioseguridad animal - Vehículo</dct:title>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/60052cc4-2c9f-4f40-9605-541fd72081e3</dct:identifier>
        <dct:description xml:lang="es">Este dataset pertenece al Piloto Bioseguridad animal que se trata de monitorizar el acceso a granjas en extensivo y de evitar la transmisión de enfermedades entre. Los datos recolectados provienen de 4  tótems situados en el Centro Nacional de capacitación agraria generados por lectores de tarjetas RFID y cámaras dotadas con lectura de matrículas.  Este dataset contiene información sobre los registros de matrículas y la localización de los vehículos registrados. Por seguridad todos los datos sensibles han sido encriptados.</dct:description>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/da8e6f5e-3c8b-4672-ac98-709af0ae65ec">
