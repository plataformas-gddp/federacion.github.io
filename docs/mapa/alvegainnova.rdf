    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/f0419444-1c20-4b04-852b-63cec138f1b9">
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:title xml:lang="es">Colmenas inteligentes - Datos interno de colmenas</dct:title>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N545fee0e29ea49728e1d145505610185">
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2027-10-01T00:00:00</dcat:endDate>
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2027-07-17T00:00:00</dcat:startDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:description xml:lang="en">Este dataset pertenece al Piloto monitorización de colmenas inteligentes desarrollado por la empresa Beeguard. Los datos generados provienen de la sensórica desplegada en 10 colmenas en diferentes explotaciones apícolas y de estaciones meteorológicas desplegadas cercanas. Este dataset contiene información sobre los datos internos de las colmenas con registros de temperatura (ºC), humedad(%), peso(Kg), conteo de entradas y salidas, junto con información administrativa como id de entidad y tipo de entidad entre otros.</dct:description>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
