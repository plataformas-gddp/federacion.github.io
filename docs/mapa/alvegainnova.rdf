    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/ceb48d59-1e5d-407d-bb43-b0c84b9e2438">
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/ceb48d59-1e5d-407d-bb43-b0c84b9e2438/resource/08b3c1be-5685-4416-aa71-d1debe2303d2"/>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:description xml:lang="es">Este dataset pertenece al Agrolab Fertilización Inteligente que se trata de generar prescripciones de fertilizante basadas en estudios fisicoquimicos y de conductividad en varias de las parcelas perteneciente al CENCA. Este dataset incluye datos sobre los estudios fisicoquímicos del suelo incluyendo datos como nutrientes (nitrógeno, fósforo, potasio), propiedades físicas (conductividad eléctrica, pH, contenido orgánico) y texturales (arena, limo, arcilla), junto con información del lote, fecha de muestreo y referencias a parcelas agrícolas.</dct:description>
