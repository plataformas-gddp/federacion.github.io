    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/502147ac-35d6-4a29-97b0-d783b85ace03">
        <dcat:contactPoint rdf:resource="https://opendata.lavegainnova.es/contact/502147ac-35d6-4a29-97b0-d783b85ace03"/>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:title xml:lang="en">Smartagrovid - Datos de suelo</dct:title>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-26T08:46:33Z</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-23T15:46:39Z</dct:issued>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:description xml:lang="en">Este dataset pertenece al Agrolab Smartagrovid que se trata de monitorizar distintos parámetros agroclimáticos en el cultivo de la vid con con dispositivos de 3 empresas distintas, Cesens, Metos y Libelium en dos viñas situadas una en la provincia de Madrid y otra en la provincia de Cádiz - Este dataset se ha construido con los datos provenientes de Libelium y contiene datos de humedad (expresada en %), temperatura (en °C) y salinidad (en dS/m) del suelo en 8 niveles cada 10 cm (de 0 a 80 cm). Concretamente, r_32_msd* representa la humedad con salinidad (%), r_32_sd* la salinidad (dS/m), r_32_td* la temperatura (°C), y r_32_mwosd* la humedad sin salinidad (%).</dct:description>
        <dcat:keyword xml:lang="es">agricultura</dcat:keyword>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/502147ac-35d6-4a29-97b0-d783b85ace03</dct:identifier>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/502147ac-35d6-4a29-97b0-d783b85ace03/resource/dd8c230b-ea3b-48dc-8f14-740deb4a6ff6"/>
        <dct:title xml:lang="es">Smartagrovid - Datos de suelo</dct:title>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:description xml:lang="es">Este dataset pertenece al Agrolab Smartagrovid que se trata de monitorizar distintos parámetros agroclimáticos en el cultivo de la vid con con dispositivos de 3 empresas distintas, Cesens, Metos y Libelium en dos viñas situadas una en la provincia de Madrid y otra en la provincia de Cádiz - Este dataset se ha construido con los datos provenientes de Libelium y contiene datos de humedad (expresada en %), temperatura (en °C) y salinidad (en dS/m) del suelo en 8 niveles cada 10 cm (de 0 a 80 cm). Concretamente, r_32_msd* representa la humedad con salinidad (%), r_32_sd* la salinidad (dS/m), r_32_td* la temperatura (°C), y r_32_mwosd* la humedad sin salinidad (%).</dct:description>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:temporal>
