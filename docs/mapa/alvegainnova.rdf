        <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-20</dcat:startDate>
      </dc:PeriodOfTime>
    </dc:temporal>

    <dc:title xml:lang="es">Fertilización Inteligente - Análisis fisicoquímicos del suelo</dc:title>
