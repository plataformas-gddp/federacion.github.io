  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece al piloto estimación de rendimiento que se trata de estimar el rendimiento de 4 explotaciones agrarias de olivar situadas en varios puntos de España. Estas estimaciones se han llevado a partir de datos históricos climáticos, satelitales, de producción y otros. Este dataset recopila datos meteorológicos y ambientales, índices de vegetación y teledetección y estimación de producción agrícola y muestra los datos históricos de proyecto.</dc:description>
    <dc:identifier>5fdc8cc9-a042-410f-85e3-66ec3615c9f3</dc:identifier>
