        <dct:title xml:lang="es">Datos ambientales y del suelo en Finca Experimental de Rabanales UCO - Datos ambientales y nivel de batería</dct:title>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-21T11:54:29.075280</dct:modified>
        <dcat:contactPoint>
          <vcard:Organization rdf:nodeID="N447a4190be074c898d1a04fa79233b34">
