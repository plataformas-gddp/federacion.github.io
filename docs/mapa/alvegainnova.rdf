        <dct:title xml:lang="es">Monitorización de silos - Comederos</dct:title>
        <dct:description xml:lang="es">Este dataset pertenece al Agrolab monitorización de silos y comederos que se trata de monitorizar distintos parámetros de estado de los silos y comederos asociados a distintas explotaciones ganaderas usando sensores y cámaras. Este dataset contiene información sobre los comederos, incluyendo registros con, nivel porcentual del comedero (%), número de visitas al comedero en el momento de la foto, indicador de si está vacío, e información administrativa.</dct:description>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/eabab50f-54d4-4724-b536-118fd3cf56d9/resource/b55f4af5-39b8-48bd-b384-fac3da9dfafa"/>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-24T07:54:26.783332</dct:issued>
        <dcat:keyword>ganadería</dcat:keyword>
