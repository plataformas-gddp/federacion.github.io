            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-31</dcat:endDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/MONTHLY"/>
        <dcat:keyword xml:lang="es">agricultura</dcat:keyword>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dcat:contactPoint rdf:resource="https://opendata.lavegainnova.es/contact/5fdc8cc9-a042-410f-85e3-66ec3615c9f3"/>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3</dct:identifier>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-02-20T09:51:04Z</dct:issued>
        <dct:description xml:lang="en">Este dataset pertenece al piloto estimación de rendimiento que se trata de estimar el rendimiento de 4 explotaciones agrarias de olivar situadas en varios puntos de España. Estas estimaciones se han llevado a partir de datos históricos climáticos, satelitales, de producción y otros. Este dataset recopila datos meteorológicos y ambientales, índices de vegetación y teledetección y estimación de producción agrícola y muestra los datos históricos de proyecto.</dct:description>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:title xml:lang="en">Estimación de Rendimiento - Histórico Agroclimático y Productivo Olivar</dct:title>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dct:title xml:lang="es">Estimación de Rendimiento - Histórico Agroclimático y Productivo Olivar</dct:title>
      </dcat:Dataset>
    </dcat:dataset>
