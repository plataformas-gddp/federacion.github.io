  <dcat:Catalog rdf:about="https://opendata.lavegainnova.es">
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/c3bb2250-daf9-474b-882e-ca42083fca67">
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
        <dct:title xml:lang="en">Agrivoltaica - Datos ambientales</dct:title>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/c3bb2250-daf9-474b-882e-ca42083fca67</dct:identifier>
        <dct:description xml:lang="es">Este dataset pertenece al Piloto Agrivoltaica que se trata de monitorizar distintos parámetros agroclimáticos de 2 explotaciones agrivoltaicas comparando valores de los cultivos en distintas posiciones para ver como afectan las placas - Este dataset contiene información sobre precipitación (l/m^2), pluviómetro(n - número de pasos/pulsos), humedad relativa (0-1), temperatura (ºC), dirección del viento (0-360º), velocidad del viento (km/h), radiación solar (W/m^2), radiación solar PAR, evapotranspiración (mm), tiempo de mojado foliar (min) y presión (hPa) entre otros</dct:description>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dcat:distribution rdf:resource="https://opendata.lavegainnova.es/dataset/c3bb2250-daf9-474b-882e-ca42083fca67/resource/adae4a3e-b35e-41fc-ad12-f273c9c14102"/>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
