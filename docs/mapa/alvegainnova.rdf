    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/2d0e29f2-8f86-49b5-b21f-7114a5c832d0">
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dct:title xml:lang="es">Smart Pivot - Datos meteorológicos observados</dct:title>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/2d0e29f2-8f86-49b5-b21f-7114a5c832d0</dct:identifier>
        <dct:description xml:lang="es">Este dataset pertenece al piloto Smartpivot que se trata de generar recomendaciones de riego basadas en sensores de humedad, Estaciones meteorológicas cercanas e imágenes satelitales de NDVI en la parcela circular perteneciente al CENCA. Este dataset incluye parámetros observados meteorológicos y ambientales, como precipitación, humedad relativa, temperatura, dirección y velocidad del viento, radiación solar, evapotranspiración, probabilidad de precipitación, cobertura de nubes, riesgo de heladas, déficit de presión de vapor y horas de enfriamiento, además de información de mantenimiento y referencias a parcelas agrícolas.</dct:description>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-26T08:53:53Z</dct:modified>
