            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-10-01</dcat:endDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-23T16:05:18Z</dct:issued>
        <dct:description xml:lang="en">Este dataset pertenece al Piloto Agrivoltaica que se trata de monitorizar distintos parámetros agroclimáticos de 2 explotaciones agrivoltaicas comparando valores de los cultivos en distintas posiciones para ver como afectan las placas - Este dataset contiene información sobre precipitación (l/m^2), pluviómetro(n - número de pasos/pulsos), humedad relativa (0-1), temperatura (ºC), dirección del viento (0-360º), velocidad del viento (km/h), radiación solar (W/m^2), radiación solar PAR, evapotranspiración (mm), tiempo de mojado foliar (min) y presión (hPa) entre otros</dct:description>
        <dcat:keyword xml:lang="es">agricultura</dcat:keyword>
