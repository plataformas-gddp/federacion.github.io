  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/2d0e29f2-8f86-49b5-b21f-7114a5c832d0">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece al piloto Smartpivot que se trata de generar recomendaciones de riego basadas en sensores de humedad, Estaciones meteorológicas cercanas e imágenes satelitales de NDVI en la parcela circular perteneciente al CENCA. Este dataset incluye parámetros observados meteorológicos y ambientales, como precipitación, humedad relativa, temperatura, dirección y velocidad del viento, radiación solar, evapotranspiración, probabilidad de precipitación, cobertura de nubes, riesgo de heladas, déficit de presión de vapor y horas de enfriamiento, además de información de mantenimiento y referencias a parcelas agrícolas.</dc:description>
    <dc:identifier>2d0e29f2-8f86-49b5-b21f-7114a5c832d0</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-01</dc:issued>
    <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-02</dc:modified>
    <dc:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
    <dc:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/>
    <dc:temporal>
      <dc:PeriodOfTime>
