  <dcat:Dataset rdf:about="http://lavegainnova.es/dataset/ceb48d59-1e5d-407d-bb43-b0c84b9e2438">
    <dc:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dc:description xml:lang="es">Este dataset pertenece al Agrolab Fertilización Inteligente que se trata de generar prescripciones de fertilizante basadas en estudios fisicoquimicos y de conductividad en varias de las parcelas perteneciente al CENCA. Este dataset incluye datos sobre los estudios fisicoquímicos del suelo incluyendo datos como nutrientes (nitrógeno, fósforo, potasio), propiedades físicas (conductividad eléctrica, pH, contenido orgánico) y texturales (arena, limo, arcilla), junto con información del lote, fecha de muestreo y referencias a parcelas agrícolas.</dc:description>
    <dc:identifier>ceb48d59-1e5d-407d-bb43-b0c84b9e2438</dc:identifier>
    <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-01</dc:issued>
    <dc:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-02</dc:modified>
