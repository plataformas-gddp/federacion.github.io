    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3">
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/5fdc8cc9-a042-410f-85e3-66ec3615c9f3</dct:identifier>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
        <dct:description xml:lang="es">Este dataset pertenece al piloto estimación de rendimiento que se trata de estimar el rendimiento de 4 explotaciones agrarias de olivar situadas en varios puntos de España. Estas estimaciones se han llevado a partir de datos históricos climáticos, satelitales, de producción y otros. Este dataset recopila datos meteorológicos y ambientales, índices de vegetación y teledetección y estimación de producción agrícola y muestra los datos históricos de proyecto.</dct:description>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-rural-pesca"/>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
