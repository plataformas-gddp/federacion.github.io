        <dct:title xml:lang="en">Colmenas inteligentes - Datos ambientales de colmenas</dct:title>
        <dct:identifier>https://opendata.lavegainnova.es/dataset/975c4124-bea6-4db5-8732-2348d4b5f519</dct:identifier>
        <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E05024401"/>
