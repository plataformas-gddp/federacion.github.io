    <dcat:dataset>
      <dcat:Dataset rdf:about="https://opendata.lavegainnova.es/dataset/3422e507-6394-4235-9cf4-187cb04ddf31">
        <dct:title xml:lang="en">Fertilización Inteligente - Prescripciones de fertilizante</dct:title>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N32b327a4446a43bbb711bb321975d6c0">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-12-20</dcat:startDate>
