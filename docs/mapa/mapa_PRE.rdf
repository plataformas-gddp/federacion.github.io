    <dcat:dataset>
      <dcat:Dataset rdf:about="https://preservicio.mapa.gob.es/dataset/esmapaindicespreciospreciopercibido">
        <dct:title xml:lang="es">Precios percibidos (mensual y anual nacional)</dct:title>
        <dct:description xml:lang="es">Evolución nacional mensual y anual de los precios que percibe el agricultor y el ganadero por la venta de los productos agrarios que genera. Generalmente, los precios están referidos a salida de explotación agraria y no incluyen: gastos de transporte, subvenciones que pueden  recibir,  impuestos  indirectos ni tasas  que  pueden  gravar  las  transacciones  de  dichos productos en las que el agricultor o ganadero actúa como vendedor</dct:description>
        <dcat:landingPage rdf:resource="https://preservicio.mapa.gob.es/ckan/dataset/esmapaindicespreciospreciopercibido" />
