    <dcat:dataset>
      <dcat:Dataset rdf:about="https://prees-datalab.ine.es/dataset/ioe304478">
        <dct:title xml:lang="es">Encuesta de Empleo del Tiempo:FICHERO SDHOGAR. SERVICIO DOMÉSTICO</dct:title>
        <dct:description xml:lang="en">Knowledge of activities carried out by persons: production of goods and services (paid and unpaid), distribution of household family responsibilities, participation of the population in culture and leisure activities, time spent on transport and other activities</dct:description>
        <dct:description xml:lang="es">Conocimiento de las actividades realizadas por las personas: actividad de producción de bienes y servicios (renumeradas y no remuneradas), distribución de las responsabilidades familiares del hogar, participación de la población en actividades culturales y de ocio, tiempo empleado en transporte y en otras actividades</dct:description>
        <dcat:landingPage rdf:resource="https://prees-datalab.ine.es/ckan/dataset/ioe304478" />
        <dct:identifier>IOE30447_8</dct:identifier>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/ANNUAL" />
        <dcat:keyword xml:lang="en">Level, structure and distribution of the populations time in different activities, percentage of persons carrying out different activities and their average and aggregate duration</dcat:keyword>
        <dcat:keyword xml:lang="es">Nivel, estructura y distribución del tiempo de la población en diferentes actividades, porcentaje de personas que realizan distintas actividades y duración promedio y agregada de aquéllas</dcat:keyword>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-07-14</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-01-01</dct:issued>
