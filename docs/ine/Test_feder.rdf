    <dcat:dataset>
      <dcat:Dataset rdf:about="https://prees-datalab.ine.es/dataset/ioe303101">
        <dct:title xml:lang="es">Flujos de la Encuesta de Población Activa, mayores de 16 años. Derechos de acceso restringidos.</dct:title>
        <dct:title xml:lang="en">Economically Active Population Flow Statistics (EFPA), aged 16 and over. Restricted access rights.</dct:title>
        <dct:identifier>IOE30310_1</dct:identifier>
        <dct:description xml:lang="en">Confidential dataset for scientific purposes regarding Economically Active Population Flow Statistics (EFPA), aged 16 and over. It collects information concerning the monitoring of the population, or particular groups thereof, over time with regard to their relationship with the labour market. This information links the situations of the interviewee at two different points in time based on the Economically Active Population Survey(EPA), with the objective of studying their evolution.</dct:description>
        <dct:description xml:lang="es">Conjunto de datos confidenciales para fines científicos de Flujos de la Encuesta de Población Activa (EFPA), mayores de 16 años. Recoge información relativa al seguimiento de la población, o grupos particulares de la misma, a lo largo del tiempo,en lo referente a su relación con el mercado laboral. Esta información vincula las situaciones en las que se encuentra el entrevistado en dos momentos de tiempo sobre la base de la Encuesta de Población Activa (EPA), con el objetivo de estudiar su evolución.</dct:description>
        <dcat:distribution>
          <dcat:Distribution rdf:about="https://prees-datalab.ine.es/dataset/ioe303101/resource/ioe303101-recurso-1">
