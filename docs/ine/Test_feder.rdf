            <dcat:accessURL rdf:resource="https://es-datalab.es/" />
          </dcat:Distribution>
        </dcat:distribution>
        <dct:title xml:lang="en">Benefits recognized in the previous fiscal year (since 2020): Temporary Disability. Restricted access rights.</dct:title>
        <dct:title xml:lang="es">Prestaciones reconocidas ejercicio anterior (inicio 2020): Incapacidad Temporal. Derechos de acceso restringidos.</dct:title>
