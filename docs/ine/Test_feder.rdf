    <dcat:dataset>
      <dcat:Dataset rdf:about="https://prees-datalab.ine.es/dataset/bde111">
        <dct:title xml:lang="es">Préstamos de la CIR e Indicadores Económicos de la Central de Balances (CIR-CBI). Derechos de acceso restringidos.</dct:title>
        <dct:description xml:lang="es">Conjunto de datos confidenciales para fines científicos de Préstamos de la CIR e Indicadores Económicos de la Central de Balances (CIR-CBI). Contiene información de empresas resultado de combinar los préstamos, operación a operación, a personas jurídicas declarados a la Central de Información de Riesgos del Banco de España (CIR) por las entidades declarantes, con una batería de ratios económico-financieros calculados por la Central de Balances (CB) a partir de las cuentas anuales que depositan las empresas en los Registros Mercantiles.</dct:description>
        <dcat:landingPage rdf:resource="https://prees-datalab.ine.es/ckan/dataset/bde111" />
