        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-01-01</dct:issued>
        <dct:description xml:lang="en">Confidential dataset for scientific purposes from Microdata on Sustainability Indicators (CBS). It contains information on sustainability indicators (ESG – Environmental, Social, and Governance) collected from the sustainability reports and Non-Financial Information Statements submitted by Spanish non-financial groups and companies, using international reference standards</dct:description>
        <dct:description xml:lang="es">Conjunto de datos confidenciales para fines científicos de Indicadores de Sostenibilidad (CBS). Contien información sobre indicadores de sostenibilidad (ESG - Environment, Social and Governance) recabados de los informes de sostenibilidad y Estados de Información No Financiera presentados por los grupos y empresas no financieras españolas, utilizando para ello los estándares internacionales de referencia.</dct:description>
        <dcat:landingPage rdf:resource="https://prees-datalab.ine.es/ckan/dataset/bde041" />
        <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2022/868/oj" />
      </dcat:Dataset>
