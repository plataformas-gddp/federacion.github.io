    <dcat:dataset>
      <dcat:Dataset rdf:about="https://prees-datalab.ine.es/dataset/bde141">
        <dct:title xml:lang="es">Tenencias de valores por sector (SHSS). Derechos de acceso restringidos.</dct:title>
        <dct:description xml:lang="es">Conjunto de datos confidenciales para fines científicos de las Tenencias de valores por sector (SHSS). Contiene información sobre las tenencias de valores de residentes en España (stocks, transacciones y otros cambios en volumen) con detalle por sectores, tanto en valores emitidos por residentes como por no residentes. Asimismo, incluye las tenencias de valores de inversores no residentes que se encuentran bajo custodia en España, lo que proporciona una visión completa de las posiciones mantenidas en el país.</dct:description>
        <dcat:landingPage rdf:resource="https://prees-datalab.ine.es/ckan/dataset/bde141" />
