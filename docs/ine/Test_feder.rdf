    <dcat:dataset>
      <dcat:Dataset rdf:about="https://prees-datalab.ine.es/dataset/ioe640513">
        <dct:title xml:lang="es">Muestra Continua de Vidas Laborales: Fichero de Afiliación. Derechos de acceso restringidos.</dct:title>
        <dct:description xml:lang="es">Conjunto de datos confidenciales para fines científicos de la Muestra Continua de Vidas Laborales. El fichero contiene el historial de relaciones laborales de los trabajadores, incluyendo regímenes, contratos, jornadas, fechas de alta y baja, convenios y características del empleador.</dct:description>
        <dcat:landingPage rdf:resource="https://prees-datalab.ine.es/ckan/dataset/ioe640513" />
        <dct:identifier>IOE64051_3</dct:identifier>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/ANNUAL" />
        <dcat:keyword xml:lang="es">demografía</dcat:keyword>
        <dcat:keyword xml:lang="es">contratos</dcat:keyword>
        <dcat:keyword xml:lang="es">cotización</dcat:keyword>
