        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/demografia" />
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/empleo" />
        <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2022/868/oj" />
        <dct:description xml:lang="es">Conjunto de datos confidenciales para fines científicos de la Encuesta Comunitaria de Fuerza de Trabajo, menores de 16 años. Presenta resultados sobre la fuerza de trabajo de forma coordinada en los países de la Unión Europea, para dar cumplimiento a la reglamentación de la Unión Europea</dct:description>
        <dct:description xml:lang="en">Confidential dataset for scientific purposes from the European Union Labour Force Survey (EU-LFS) for the population under 16 years old. It presents labour force statistics in a coordinated manner across European Union countries to comply with EU regulations</dct:description>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-01-01</dct:issued>
        <dct:identifier>IOE30309_2</dct:identifier>
