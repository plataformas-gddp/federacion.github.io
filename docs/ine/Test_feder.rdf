        <dcat:keyword xml:lang="en">labour cost by components</dcat:keyword>
        <dcat:keyword xml:lang="es">labour cost by components</dcat:keyword>
        <dct:title xml:lang="en">Annual Labour Cost Survey. Contribution Accounts. Restricted access rights.</dct:title>
        <dct:title xml:lang="es">Encuesta Anual de Coste Laboral. Cuentas de cotización. Derechos de acceso restringidos.</dct:title>
