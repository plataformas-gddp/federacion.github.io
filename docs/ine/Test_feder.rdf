        <dct:title xml:lang="en">Death statistics according to cause of death. Restricted access rights.</dct:title>
        <dct:title xml:lang="es">Estadística de Defunciones según la Causa de Muerte. Derechos de acceso restringidos.</dct:title>
        <dcat:keyword xml:lang="es">late fetal deaths</dcat:keyword>
