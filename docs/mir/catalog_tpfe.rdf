    <dcat:dataset>
      <dcat:Dataset rdf:about="https://gobdatos.tpfe.es/dataset/mirea0044546dsalimentacion000001">
        <dct:title xml:lang="es">TPFE: Aprovisionamiento de materias primas consumidas en los centros penitenciarios y centros de inserción social (CIS)</dct:title>
        <dct:description xml:lang="es">Conjunto de datos relativo al consumo de materias primas en los centros penitenciarios y CIS gestionados en el ámbito de TPFE. Incluye la identificación del centro, la clasificación y descripción de la materia prima, la cantidad consumida y la unidad de medida correspondiente. Su contenido permite conocer y comparar los consumos de materias primas entre centros. No se incluyen los datos de los centros de Cataluña ni del País Vasco, al tratarse de una competencia transferida a dichas comunidades autónomas.</dct:description>
        <dct:identifier>MIR:EA0044546:ds:ALIMENTACION:000001</dct:identifier>
