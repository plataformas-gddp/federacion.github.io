    <dcat:dataset>
      <dcat:Dataset rdf:about="https://gobdatos.tpfe.es/dataset/mirea0044546dsocupacion000001">
        <dct:title xml:lang="es">TPFE: Ocupación laboral productiva de la población interna en los centros penitenciarios y centros de inserción social (CIS)</dct:title>
        <dct:description xml:lang="es">Conjunto de datos de ocupación de los talleres penitenciarios de carácter productivo organizados por centros y actividades. Incluye únicamente la población interna trabajadora que percibe una retribución mensual en función de su actividad, tomando como referencia un módulo retributivo revisado anualmente por el Consejo de Administración del Ente Público. No se incluyen los datos de los centros de Cataluña ni del País Vasco, al tratarse de una competencia transferida a dichas comunidades autónomas.</dct:description>
        <dct:identifier>MIR:EA0044546:ds:OCUPACION:000001</dct:identifier>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/MONTHLY" />
