    <dcat:dataset>
	<dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/f823d4da-8610-4b09-9622-061437fa0aba">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title xml:lang="en">Zonal electrical quality</dct:title>
    <dct:title xml:lang="es">Calidad eléctrica zonal</dct:title>
    <dct:description xml:lang="en">Information on zonal quality data related to the continuity of the electricity supply in Spain. The continuity of electricity supply is determined by the number and duration of interruptions.&#13;
For further information, you can visit the specific corresponding section on the Ministry's website: &#13;
https://www.miteco.gob.es/es/energia/energia-electrica/electricidad/calidad-servicio.html&#13;
</dct:description>
    <dct:description xml:lang="es">Información sobre los datos de calidad zonal relativos a la continuidad del suministro eléctrico en España.&#13;
La continuidad del suministro viene determinada por el número y la duración de las interrupciones.&#13;
Para más información, puede visitar el apartado específico correspondiente en la web del Ministerio:&#13;
https://www.miteco.gob.es/es/energia/energia-electrica/electricidad/calidad-servicio.html</dct:description>
