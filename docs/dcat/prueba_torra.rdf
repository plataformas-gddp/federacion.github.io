    <dcat:dataset>
      <dcat:Dataset rdf:about="https://172.20.200.5:8443/dataset/mirea0044546dsformacion000001">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document" />
        <dct:title xml:lang="es">TPFE: Formación para el empleo e inserción laboral impartidas en centros penitenciarios y centros de inserción social (CIS)</dct:title>
        <dct:description xml:lang="es">Conjuntos de datos de programas formativos certificados impartidos a la población interna por Trabajo Penitenciario y Formación para el Empleo. Incluye información sobre los programas de formación para el empleo e inserción laboral desarrollados en los centros penitenciarios y CIS. No se incluyen los datos de los centros de Cataluña ni del País Vasco, al tratarse de una competencia transferida a dichas comunidades autónomas.</dct:description>
        <dcat:landingPage rdf:resource="https://172.20.200.5:8443/dataset/mirea0044546dsformacion000001" />
        <dct:identifier>MIR:EA0044546:ds:FORMACION:000001</dct:identifier>
