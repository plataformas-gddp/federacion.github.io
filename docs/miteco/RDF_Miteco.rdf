  <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/9b635d3a-d1f9-4721-96d0-3914d977ae78">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title xml:lang="en">Weekly Hydrological Bulletin</dct:title>
    <dct:title xml:lang="es">Boletín Hidrológico semanal</dct:title>
    <dct:description xml:lang="en">The Hydrological Bulletin is a weekly publication produced by the Hydrological Information Area, which receives data originating from the River Basin Authorities and the intra-community water administrations, the State Meteorological Agency and the Spanish Electricity Network, carrying out the technical processing of the information for its presentation as support for water management decisions that must be taken at the national level, with their technical, economic and social implications.</dct:description>
    <dct:description xml:lang="es">El Boletín Hidrológico es una publicación de periodicidad semanal realizada por el Área de Información Hidrológica, que recibe los datos que se originan en las Confederaciones Hidrográficas y en las Administraciones hidráulicas intracomunitarias, la Agencia Estatal de Meteorología y Red Eléctrica de España, realizando el tratamiento técnico de la información para su presentación como soporte de las decisiones de gestión hídrica que se deben tomar a nivel nacional, con sus implicaciones técnicas, económicas y sociales.</dct:description>
    <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/9b635d3a-d1f9-4721-96d0-3914d977ae78"/>
