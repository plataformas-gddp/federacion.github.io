<https://www.idee.es/csw-codsi-idee/srv/api/records/32b1ecd2-487e-445e-9276-e97c6bb8e439> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_7b8fbb64>,
        <http://data.europa.eu/bna/c_dd313021> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description """La intrusión salina es un fenómeno común que se produce en algunas masas de agua subterráneas costeras, especialmente en el caso de acuíferos sobreexplotados, y que puede afectar la calidad de las aguas. Este indicador solo se ha analizado sobre aguas subterráneas. Los valores de cambio vendrán definidos por los identificados en la siguiente tabla, según la concentración de cloruros.
            En este análisis se han considerado todas analíticas de sustancias de cloruros disponibles en los Programas de Seguimiento (programa de control de vigilancia y operativo) de aguas subterráneas previstos para evaluar el estado, en cumplimiento de la normativa estatal y europea, de las que se dispone de información en NABIA (Sistema de intercambio de información sobre el estado y calidad de las aguas)."""@es ;
    dcterms:identifier "32b1ecd2-487e-445e-9276-e97c6bb8e439" ;
    dcterms:issued "2024-08-22"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-9.75 35.00, 4.57 35.00, 4.57 44.04, -9.75 44.04, -9.75 35.00))"^^geo:wktLiteral ] ;
    dcterms:title "Indicadores de Calidad de las Aguas subterráneas: Identificación de la intrusión salina en aguas subterráneas (2023)"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/32b1ecd2-487e-445e-9276-e97c6bb8e439> ;
