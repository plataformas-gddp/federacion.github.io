    dcatap:hvdCategory <http://data.europa.eu/bna/c_6c2bb82d>,
        <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "Representation of geographical names such as the names of localities, cities, towns or settlements, or any geographical or topographical feature of public or historical interest within the geographical scope of the Community of Madrid, from the Basic Geographical Gazetteer of Spain (NGBE), which constitutes the Geographical Gazetteer of Community of Madrid (NGCM). The coordinates are in the ETRS89 geodetic reference system, both in geographical longitude and latitude coordinates and in X, Y coordinates in UTM projection in zone 30. Available in database format in the Area of the Regional Cartographic Information Centre.)"@en,
        "Representación de nombres geográficos como los nombres de localidades, ciudades, poblaciones o asentamientos, o cualquier rasgo geográfico o topográfico de interés público o histórico dentro del ámbito geográfico de la Comunidad de Madrid, procedentes del Nomenclátor Geográfico Básico de España (NGBE), y que constituye el NOMENCLÁTOR GEOGRÁFICO DE LA COMUNIDAD DE MADRID (NGCM). Las coordenadas se encuentran en el sistema geodésico de referencia ETRS89 tanto en coordenadas geográficas longitud y latitud como en coordenadas X, Y en proyección UTM en el huso 30. Disponible en formato base de datos en el Área del Centro Regional de Información Cartográfico."@es ;
    dcterms:identifier "spacm_ngcm" ;
    dcterms:issued "2020-05-19"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
