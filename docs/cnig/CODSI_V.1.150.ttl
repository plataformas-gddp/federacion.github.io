    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "La Base Topográfica Armonizada (BTA) es un conjunto de datos vectoriales de carácter topográfico, a escala 1:5.000, que se conforma en la CAPV mediante la armonización de diferentes fuentes de información, y que está basada en las especificaciones a tal respecto publicadas por el Consejo Superior Geográfico. Se permite así la interoperabilidad y el intercambio de información geográfica entre las distintas Comunidades Autónomas (CC.AA.), Diputaciones Forales(DD.FF.) o la Administración General del Estado (AGE). Esta Base topográfica vectorial recoge diferentes fenómenos, como son: puntos de referencia, transportes, hidrografía, relieve, cubierta terrestre, edificaciones, servicios e instalaciones y toponimia."@es ;
    dcterms:identifier "md_ideeu_euskadi_bta5_es" ;
    dcterms:issued "2009-01-01"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
