    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description """True orthophotos generated from the 2025 flights of the National Aerial Orthophotography Plan for Murcia and Extremadura, with a 25 cm resolution. Obtained from the PNOA flight orientation.
The creation dates for each mosaic are:
Cáceres: November 2025
Badajoz: November 2025
Murcia: November 2025
Cartagena: November 2025"""@en,
        """Ortoimagenes verdaderas generadas a partir de los vuelos del año 2025 del Plan Nacional de Ortofotografía Aérea de Murcia y Extremadura con una resolución de 25 cm. Obtenida a partir de la orientación del vuelo PNOA.
Las fechas de creación de cada mosaico son:
Cáceres: noviembre 2025
Badajoz: noviembre 2025
Murcia: noviembre 2025
Cartagena: noviembre 2025"""@es ;
    dcterms:identifier "spaignTrueOrto2025" ;
    dcterms:issued "2025-11-01"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((1.14 38.62, 4.35 38.62, 4.35 40.10, 1.14 40.10, 1.14 38.62))"^^geo:wktLiteral ] ;
    dcterms:title "True orthophotos of 2025"@en,
        "Ortoimágenes verdaderas de 2025"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaignTrueOrto2025> ;
