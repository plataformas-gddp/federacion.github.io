    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/2930c02a-eb5f-41f3-8245-d1768ec543bd/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/2930c02a-eb5f-41f3-8245-d1768ec543bd> ;
