    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/8887bd3f-c130-4874-be3a-4f429d9144c9/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/8887bd3f-c130-4874-be3a-4f429d9144c9> ;
