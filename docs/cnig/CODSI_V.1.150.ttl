<https://www.idee.es/csw-codsi-idee/srv/api/records/0e425f02-c564-4a34-86ce-17ce2ab3be00> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_dd313021> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description """La cartografía incluida en este servicio contiene la información de las poblaciones aisladas existentes en España, actualizados a fecha de Mayo de 2018.
Según la Directiva 1999/31/CE del Consejo de 26 de abril de 1999 relativa al vertido de residuos define “población aislada” como la población:
•	Con 500 habitantes como máximo por municipio o población y con 5 habitantes como máximo por kilómetro cuadrado, y 
•	Con una distancia hasta la aglomeración urbana más próxima de 250 habitantes por kilómetro cuadrado no inferior a 50 kilómetros, o con una comunicación difícil por carretera hasta estas aglomeraciones más próximas debido a condiciones meteorológicas desfavorables durante una parte importante del año."""@es ;
    dcterms:identifier "0e425f02-c564-4a34-86ce-17ce2ab3be00" ;
    dcterms:issued "2018-05-30"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-19.00 27.00, 4.57 27.00, 4.57 44.04, -19.00 44.04, -19.00 27.00))"^^geo:wktLiteral ] ;
    dcterms:title "Poblaciones aisladas en el ámbito del RD 1481/2001"@es ;
