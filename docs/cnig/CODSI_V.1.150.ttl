<https://www.idee.es/csw-codsi-idee/srv/api/records/AU_administrativeboundaries_dataset> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205>,
        <http://data.europa.eu/eli/reg/2010/1089>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_9427236f>,
        <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "The administrative boundaries of the Provincial Council of Alava are vector files in accordance with the data model established by the INSPIRE Directive EC/2/2007, which include the municipal administrative divisions of the Historical Territory of Araba/Álava. The boundary lines are supported by boundary demarcation acts. It is possible to download the information in SHP format. The geodetic reference system of origin of the dataset is ETRS89 and the UTM projection is UTM zone 30, and it is possible to download it in different reference systems."@en,
        "Los límites administrativos de la Diputación Foral de Álava son ficheros vectoriales acorde al modelo de datos establecido por la Directiva Inspire CE/2/2007, que recogen las divisiones administrativas municipales del  Territorio Histórico de Araba/Álava. Las líneas límite se encuentran respaldadas por Actas de deslinde. Es posible descargar la información en formato SHP. El sistema geodésico de referencia origen del conjunto de datos es ETRS89 y la proyección UTM huso 30, siendo posible su descarga en diversos sistemas de referencia."@es ;
    dcterms:identifier "AU_administrativeboundaries_dataset" ;
    dcterms:issued "2017-04-06"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-3.29 42.47, -2.23 42.47, -2.23 43.22, -3.29 43.22, -3.29 42.47))"^^geo:wktLiteral ] ;
    dcterms:title "Administrative Boundaries of Araba/Álava (INSPIRE)"@en,
        "Límites Administrativos de Araba/Álava (INSPIRE)"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/AU_administrativeboundaries_dataset> ;
    dcat:contactPoint <https://www.idee.es/csw-codsi-idee/srv/api/records/DepartamentodeEquilibrioTerritorialyOrdenaciondelTerritorio> ;
    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/AU_administrativeboundaries_dataset> ;
    dcat:keyword "Administrative units"@es,
        "Geospatial"@es,
