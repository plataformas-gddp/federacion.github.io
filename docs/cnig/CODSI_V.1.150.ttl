<https://www.idee.es/csw-codsi-idee/srv/api/records/99b64a12-c1e1-444b-8f70-26fe6f7a0d7d> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
