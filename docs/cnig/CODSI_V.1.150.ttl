<https://www.idee.es/csw-codsi-idee/srv/api/records/md_ideeu_callejero_es> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205>,
        <http://data.europa.eu/eli/reg/2010/1089>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "El Callejero de la Comunidad Autónoma del País Vasco se compone de una capa que recoge los Portales Oficiales del País Vasco más aquellos edificios que si bien no tienen una dirección oficial, son de interes, almacenando el bloque, el número y el portal bis. Y de una segunda capa de ejes de calles, la cual recoge un sistema reticular que se extiende por todos los viales de la Comunidad Autónoma Vasca comunicacando todos los portales entre sí. Esta capa contiene información del vial en el que esta ubicado el tramo de eje, el rango de los portales que contiene, la entidad de población y núcleo a que pertenece dicho tramo."@es ;
    dcterms:identifier "md_ideeu_callejero_es" ;
    dcterms:issued "2001-12-31"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
