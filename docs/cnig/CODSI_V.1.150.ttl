    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "Red diseñada para el seguimiento de los efectos del cambio climático en los ecosistemas acuáticos. La red está diseñada con objeto de detectar tendencias a largo plazo en el estado de las aguas debidas a cambios en las condiciones naturales. Los puntos de muestreo se ubican en masas de agua inalteradas y sin presiones antropogénicas significativas. Por ello, además de ser más vulnerables, permiten identificar las alteraciones atribuibles potencialmente al cambio climático."@es ;
    dcterms:identifier "99b64a12-c1e1-444b-8f70-26fe6f7a0d7d" ;
    dcterms:issued "2022-06-01"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
