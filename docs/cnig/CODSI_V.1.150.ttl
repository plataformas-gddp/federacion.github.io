<https://www.idee.es/csw-codsi-idee/srv/api/records/spaminetadpermisosysondeos> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "Conjunto de datos de localización de Permisos de Investigación y Concesiones de Explotación activos así como de campañas sísmicas y sondeos de hidrocarburos en España. Este conjunto de datos permite la visualización y consulta de los datos de Permisos de Investigación de Hidrocarburos existentes, tanto de competencia estatal como autonómica, así como las Concesiones de Explotación de yacimientos de hidrocarburos o de almacenamiento para los mismos, todas ellas de competencia estatal. Asimismo, permite la visualización y consulta de los datos de sondeos de hidrocarburos y campañas sísmicas realizadas en el desarrollo de la actividad, tanto de competencia estatal como autonómica. Las actividades de exploración, investigación y explotación de hidrocarburos en España, están reguladas por la Ley 34/1998, de 7 de octubre, del Sector de Hidrocarburos. Es posible obtener más información detallada, en relación con el dominio minero de hidrocarburos y el estado administrativo de los títulos demaniales, así como de los trabajos ejecutados y la información técnica generada, accediendo al servicio web del Archivo Técnico de Hidrocarburos: https://geoportal.minetur.gob.es/ATHv2/selectAuthentication.do"@es ;
    dcterms:identifier "spaminetadpermisosysondeos" ;
    dcterms:issued "2016-03-02"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-19.00 27.60, 4.30 27.60, 4.30 44.60, -19.00 44.60, -19.00 27.60))"^^geo:wktLiteral ] ;
    dcterms:title "Dominio Minero de Hidrocarburos y Sondeos de España"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaminetadpermisosysondeos> ;
    dcat:contactPoint <https://www.idee.es/csw-codsi-idee/srv/api/records/MinisterioparalaTransicionEcologicayelRetoDemografico> ;
    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaminetadpermisosysondeos> ;
    dcat:keyword "Nacional"@es,
        "Recursos energéticos"@es ;
