<https://www.idee.es/csw-codsi-idee/srv/api/records/ed02fd91-79f8-45c0-a2f0-81814cd8c19d> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_793164b6>,
        <http://data.europa.eu/bna/c_dd313021> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description """Las especies de interés comunitario son un conjunto de especies seleccionadas como especialmente relevantes para la conservación de la biodiversidad en la Unión Europea. Su protección está amparada por la Directiva 92/43/CEE o Directiva Hábitats. 
El presente conjunto de datos muestra su amplitud geográfica, evaluada en el periodo 2013 a 2018, conforme a la información aportada por las administraciones competentes. 
La amplitud de esta distribución es un factor clave a la hora de conocer sus tendencias territoriales y contribuir así a mantener o alcanzar un estado una superficie de conservación favorable en el conjunto de la región biogeográfica."""@es ;
    dcterms:identifier "ed02fd91-79f8-45c0-a2f0-81814cd8c19d" ;
    dcterms:issued "2020-11-30"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-19.00 27.00, 4.57 27.00, 4.57 44.04, -19.00 44.04, -19.00 27.00))"^^geo:wktLiteral ] ;
    dcterms:title "Rangos de Especies Artículo 17 (período 2013-2018)"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/ed02fd91-79f8-45c0-a2f0-81814cd8c19d> ;
