            dcat:bbox "POLYGON((0.147384 40.513877, 3.344571 40.513877, 3.344571 42.870501, 0.147384 42.870501, 0.147384 40.513877))"^^geo:wktLiteral ] ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2021-02-19"^^xsd:date ;
            dcat:startDate "2021-02-19"^^xsd:date ] ;
