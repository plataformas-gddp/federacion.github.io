<https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesPadron> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "Serie anual del Censo de Población y Viviendas 2001 correspondientes al Censo Electoral (CE) y Padrón Municipal de Habitantes (PA). Se añade el seccionado de los Censos de Población y Viviendas 2001 (CPV) a fecha oficial de su recogida, 1 de Noviembre. Los elementos de cada serie son dos: únicamente Distritos y, dentro de los mismos, Secciones. La delimitación territorial de las Secciones Censales establece el ámbito de esta unidad estadística inferior al municipio que es la base de la mayoría de las operaciones estadísticas del Sistema Estadístico Nacional: censos, padrones, encuestas y otras operaciones estadísticas. Todo municipio se divide en una o más Secciones Censales y no hay ninguna parte del municipio que no pertenezca a una Sección Censal. Las secciones de un municipio se agrupan en uno o más Distritos Censales y toda Sección pertenece a un Distrito Censal. La serie arranca a partir del año 2007, a 1 de enero para cada año, incluyendo además las fechas censales, como el 1 noviembre para los años 2001. Escala mínima de visibilidad: 1:1.000.000 para Distrito y 1:250.000 para Sección Censal."@es ;
    dcterms:identifier "spaINE_SeccionesPadron" ;
    dcterms:issued "2001-11-01"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-19.00 27.60, 4.31 27.60, 4.31 44.00, -19.00 44.00, -19.00 27.60))"^^geo:wktLiteral ] ;
    dcterms:title "Sections of the 2001 Population and Housing Census of Spain"@en,
        "Secciones Censo Población y Viviendas 2001 de España"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaINE_SeccionesPadron> ;
    dcat:contactPoint <https://www.idee.es/csw-codsi-idee/srv/api/records/InstitutoNacionaldeEstadistica> ;
    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesPadron/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaINE_SeccionesPadron> ;
