            dcat:bbox "POLYGON((-9.75 35.00, 4.57 35.00, 4.57 44.04, -9.75 44.04, -9.75 35.00))"^^geo:wktLiteral ] ;
    dcterms:title "Indicadores de Calidad de las Aguas superficiales: Contenido de fósforo total en lagos (2024)"@es ;
