<https://www.idee.es/csw-codsi-idee/srv/api/records/fb326c11-18d4-4ee1-aa23-a40cb90cf8d8> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
