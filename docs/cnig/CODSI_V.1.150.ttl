<https://www.idee.es/csw-codsi-idee/srv/api/records/9cb79664-854f-44a8-95f8-1407bab7c58a> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_dd313021> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description """Posición de los puntos de vertido desde las plantas depuradoras, de acuerdo con la Directiva 91/271/CEE sobre el tratamiento de las aguas residuales urbanas. La información sobre las aglomeraciones urbanas, depuradoras de aguas residuales, sus puntos de vertido y las zonas sensibles ha sido remitida a la Comisión Europea según el modelo de datos especificado en la web del EIONET http://cdr.eionet.europa.eu/help/UWWTD/UWWTD_613 , y su contenido se puede encontrar en la página web de Reportnet 3.0 https://reportnet.europa.eu/public/dataflow/1043.
La cartografía se corresponde con los puntos de vertido activos (cuyos datos están vigentes y no han sido dados de baja) de las estaciones depuradoras  reportadas en el último informe de seguimiento "Cuestionario 2023" (Q2023) que contiene datos de situación a diciembre de 2022 de la implementación de la Directiva 91/271/CEE reportados a la Comisión Europea en 2024."""@es ;
    dcterms:identifier "9cb79664-854f-44a8-95f8-1407bab7c58a" ;
    dcterms:issued "2025-01-31"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-19.00 27.00, 4.57 27.00, 4.57 44.04, -19.00 44.04, -19.00 27.00))"^^geo:wktLiteral ] ;
    dcterms:title "Puntos de vertido de depuradoras urbanas (Q2023. Dir 91/271/CEE)"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
