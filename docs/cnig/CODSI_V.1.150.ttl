    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/280578ff-33f0-48c0-b335-ba0263a428d3/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/280578ff-33f0-48c0-b335-ba0263a428d3> ;
