<https://www.idee.es/csw-codsi-idee/srv/api/records/5b351f93-1719-425e-88a4-8298d4f87b7f> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_af646f5b>,
        <http://data.europa.eu/bna/c_dd313021> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description """Aguas afectadas por la contaminación de nitratos procedentes de la actividad agraria. Es información básica para la declaración de Zonas Vulnerables conforme al Real Decreto 47/2022, de 18 de enero, sobre protección de las aguas contra la contaminación difusa producida por los nitratos procedentes de fuentes agrarias y a la Directiva 91/676/CEE, relativa a la protección de las aguas contra la contaminación producida por nitratos procedentes de fuentes agrarias ("Directiva de Nitratos").  
La identificación de estas aguas parte de la información recogida en el informe de situación notificado a la Comisión europea sobre la aplicación de la directiva en el cuatrienio 2016-2019.  Esta información plasma sin modificación alguna, la información sobre calidad de las aguas notificada nitratos y, en especial, por los de origen agrario, así como de las aguas que podrían verse afectadas por dicha contaminación si no se toman las medidas oportunas."""@es ;
    dcterms:identifier "5b351f93-1719-425e-88a4-8298d4f87b7f" ;
    dcterms:issued "2022-03-28"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
