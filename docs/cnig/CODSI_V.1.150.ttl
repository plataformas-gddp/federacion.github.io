    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/d85449b4-f3b8-48e8-8597-1a950809ca65/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/d85449b4-f3b8-48e8-8597-1a950809ca65> ;
