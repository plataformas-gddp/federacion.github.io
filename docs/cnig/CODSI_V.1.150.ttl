<https://www.idee.es/csw-codsi-idee/srv/api/records/AU_administrativeunits_dataset> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205>,
        <http://data.europa.eu/eli/reg/2010/1089>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_9427236f>,
        <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "The administrative units of the Provincial Council of Alava represent the areas of the Historical Territory of Alava where the municipal corporations exercise their powers. They are vector files in accordance with the data model established by the Directive Inspire CE/2/2007, which are available for download in SHP format. The geodetic reference system of origin of the dataset is ETRS89 and the UTM projection is 30N, and can be downloaded in different reference systems."@en,
        "Las unidades administrativas de la Diputación Foral de Álava representan las áreas del Territorio Histórico de Álava donde las corporaciones municipales ejercen sus competencias. Son ficheros vectoriales acorde al modelo de datos establecido por la Directiva Inspire CE/2/2007, cuya descarga se ofrece en formato SHP. El sistema geodésico de referencia origen del conjunto de datos es ETRS89 y la proyección UTM huso 30N, siendo posible su descarga en diversos sistemas de referencia."@es ;
    dcterms:identifier "AU_administrativeunits_dataset" ;
    dcterms:issued "2017-04-06"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
