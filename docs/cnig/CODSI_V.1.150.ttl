    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/ad6501b9-e3dc-416a-b458-a184fecbbd4f/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/ad6501b9-e3dc-416a-b458-a184fecbbd4f> ;
