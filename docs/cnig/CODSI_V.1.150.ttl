        <http://inspire.ec.europa.eu/theme/ef> ;
    foaf:page <http://data.europa.eu/eli/reg_impl/2023/138/oj> .

<https://www.idee.es/csw-codsi-idee/srv/api/records/a255a7fb-1240-4443-b759-62b76f721757> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_af646f5b>,
