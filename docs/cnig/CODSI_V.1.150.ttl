<https://www.idee.es/csw-codsi-idee/srv/api/records/md_ideeu_mdt_lidar_2017_es> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205>,
        <http://data.europa.eu/eli/reg/2010/1089>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_315692ad>,
        <http://data.europa.eu/bna/c_dd313021> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "The 2017 Digital Terrain Model of 1m grid pitch reflects the bare surface of the terrain. This DTM, which originates from the DTM published in 2016 on the geoEuskadi portal, incorporates the changes in the terrain in urban areas observed in the Basque Government's 2017 10cm photogrammetric flight of urban areas and the changes in the terrain outside urban areas that have been updated with the 2017 LIDAR data. Improvements have also been made in those areas of the DTM where the point density of the 2008 and 2012 LIDAR data did not give a good definition of the relief in the generation of the DTM."@en,
        "El Modelo Digital del Terreno de 2017 de paso de malla 1m refleja la superficie desnuda del terreno. Este MDT que tiene como origen el MDT publicado en 2016 en el portal de geoEuskadi, incorpora los cambios en el terreno en áreas urbanas observados en el vuelo fotogramétrico de 10cm de zonas urbanas del Gobierno vasco del año 2017 y los cambios en el terreno fuera de zonas urbanas que se han actualizado con los datos LIDAR del 2017. También se han hecho mejoras, en aquellas zonas del MDT, dónde la densidad de puntos de los datos LIDAR 2008 y 2012 no dieron una buena definición del relieve en la generación del MDT."@es ;
    dcterms:identifier "md_ideeu_mdt_lidar_2017_es" ;
    dcterms:issued "2020-03-18"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-3.50 42.46, -1.72 42.46, -1.72 43.79, -3.50 43.79, -3.50 42.46))"^^geo:wktLiteral ] ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2017-10-11"^^xsd:date ;
            dcat:startDate "2008-02-08"^^xsd:date ] ;
    dcterms:title "Digital Terrain Model (DTM) of 1m the Autonomous Community of the Basque Country. Year 2017."@en,
        "Modelo Digital del Terreno (MDT) de 1m de la Comunidad Autónoma del País Vasco. Año 2017."@es ;
