    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/1c7fdbf7-a431-4de6-9b1d-0ea6750c7b13/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/1c7fdbf7-a431-4de6-9b1d-0ea6750c7b13> ;
