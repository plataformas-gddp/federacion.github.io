<https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesCensales> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2008/1205/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_ac64a52d> ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcterms:conformsTo <https://datosgobes.github.io/DCAT-AP-ES> ;
    dcterms:description "Census sections in Spain since 2001, grouped by year. The territorial delimitation of the Census Sections in Spain establishes the scope of this statistical unit below the municipality, which is the basis for most of the statistical operations of the National Statistical System: censuses, censuses, surveys and other statistical operations. Every municipality is divided into one or more Census Sections and there is no part of the municipality that does not belong to a Census Section. The sections of a municipality are grouped into one or more Census Districts and every Section belongs to a Census District."@en,
        "Sencciones censales de España desde el año 2001 y agrupados por año. La delimitación territorial de las Secciones Censales de España establece el ámbito de esta unidad estadística inferior al municipio que es la base de la mayoría de las operaciones estadísticas del Sistema Estadístico Nacional: censos padrones, encuestas y otras operaciones estadísticas. Todo municipio se divide en uno o más Secciones Censales y no hay ninguna parte del municipio que no pertenezca a un Sección Censal. Las secciones de un municipio se agrupan en uno o más Distritos Censales y toda Sección pertenece a un Distrito Censal."@es ;
    dcterms:identifier "spaINE_SeccionesCensales" ;
    dcterms:issued "2001-11-01"^^xsd:date ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dcterms:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002> ;
    dcterms:spatial [ a dcterms:Location ;
            dcat:bbox "POLYGON((-19.00 27.60, 4.31 27.60, 4.31 44.00, -19.00 44.00, -19.00 27.60))"^^geo:wktLiteral ] ;
    dcterms:title "Statistical Sectioning of Spain"@en,
        "Secciones Censales de España"@es ;
    dcterms:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaINE_SeccionesCensales> ;
    dcat:contactPoint <https://www.idee.es/csw-codsi-idee/srv/api/records/InstitutoNacionaldeEstadistica> ;
    dcat:distribution <https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesCensales/formatters/html>,
        <https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaINE_SeccionesCensales> ;
    dcat:keyword "España"@es,
        "INE"@es,
        "Nacional"@es,
        "Unidades estadísticas"@es ;
