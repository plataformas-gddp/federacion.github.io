    <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002"/>
    <dct:spatial>
      <dct:Location>
        <dcat:bbox rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POLYGON((-9.75 35.00, 4.57 35.00, 4.57 44.04, -9.75 44.04, -9.75 35.00))</dcat:bbox>
      </dct:Location>
    </dct:spatial>
