    <dcat:keyword xml:lang="es">Local</dcat:keyword>
    <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/urbanismo-infraestructuras"/>
    <dcat:theme rdf:resource="http://inspire.ec.europa.eu/theme/ad"/>
    <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg_impl/2023/138/oj"/>
    <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2008/1205"/>
    <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2010/1089"/>
    <dcatap:hvdCategory rdf:resource="http://data.europa.eu/bna/c_ac64a52d"/>
    <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dct:conformsTo rdf:resource="https://datosgobes.github.io/DCAT-AP-ES"/>
    <dct:description xml:lang="es">El Callejero de la Comunidad Autónoma del País Vasco se compone de una capa que recoge los Portales Oficiales del País Vasco más aquellos edificios que si bien no tienen una dirección oficial, son de interes, almacenando el bloque, el número y el portal bis. Y de una segunda capa de ejes de calles, la cual recoge un sistema reticular que se extiende por todos los viales de la Comunidad Autónoma Vasca comunicacando todos los portales entre sí. Esta capa contiene información del vial en el que esta ubicado el tramo de eje, el rango de los portales que contiene, la entidad de población y núcleo a que pertenece dicho tramo.</dct:description>
    <dct:identifier>md_ideeu_callejero_es</dct:identifier>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2001-12-31</dct:issued>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
    <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002"/>
