  <dcat:Dataset rdf:about="https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesPadron">
    <adms:identifier rdf:resource="https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/spaINE_SeccionesPadron"/>
    <dcat:contactPoint>
      <vcard:Organization rdf:about="https://www.idee.es/csw-codsi-idee/srv/api/records/InstitutoNacionaldeEstadistica">
        <vcard:fn xml:lang="es">Instituto Nacional de Estadística</vcard:fn>
        <vcard:hasEmail rdf:resource="mailto:infoine@ine.es"/>
