      <dct:Location>
        <dcat:bbox rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POLYGON((-7.64 37.92, -4.43 37.92, -4.43 40.54, -7.64 40.54, -7.64 37.92))</dcat:bbox>
      </dct:Location>
    </dct:spatial>
