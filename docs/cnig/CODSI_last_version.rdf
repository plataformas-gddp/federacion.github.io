    <dcatap:hvdCategory rdf:resource="http://data.europa.eu/bna/c_ac64a52d"/>
    <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dct:conformsTo rdf:resource="https://datosgobes.github.io/DCAT-AP-ES"/>
    <dct:description xml:lang="es">Sencciones censales de España desde el año 2001 y agrupados por año. La delimitación territorial de las Secciones Censales de España establece el ámbito de esta unidad estadística inferior al municipio que es la base de la mayoría de las operaciones estadísticas del Sistema Estadístico Nacional: censos padrones, encuestas y otras operaciones estadísticas. Todo municipio se divide en uno o más Secciones Censales y no hay ninguna parte del municipio que no pertenezca a un Sección Censal. Las secciones de un municipio se agrupan en uno o más Distritos Censales y toda Sección pertenece a un Distrito Censal.</dct:description>
    <dct:description xml:lang="en">Census sections in Spain since 2001, grouped by year. The territorial delimitation of the Census Sections in Spain establishes the scope of this statistical unit below the municipality, which is the basis for most of the statistical operations of the National Statistical System: censuses, censuses, surveys and other statistical operations. Every municipality is divided into one or more Census Sections and there is no part of the municipality that does not belong to a Census Section. The sections of a municipality are grouped into one or more Census Districts and every Section belongs to a Census District.</dct:description>
    <dct:identifier>spaINE_SeccionesCensales</dct:identifier>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2001-11-01</dct:issued>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
    <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002"/>
    <dct:spatial>
      <dct:Location>
        <dcat:bbox rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POLYGON((-19.00 27.60, 4.31 27.60, 4.31 44.00, -19.00 44.00, -19.00 27.60))</dcat:bbox>
      </dct:Location>
    </dct:spatial>
    <dct:title xml:lang="es">Secciones Censales de España</dct:title>
    <dct:title xml:lang="en">Statistical Sectioning of Spain</dct:title>
