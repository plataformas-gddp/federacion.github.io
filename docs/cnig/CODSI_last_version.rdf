    <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dct:conformsTo rdf:resource="https://datosgobes.github.io/DCAT-AP-ES"/>
    <dct:description xml:lang="es">La intrusión salina es un fenómeno común que se produce en algunas masas de agua subterráneas costeras, especialmente en el caso de acuíferos sobreexplotados, y que puede afectar la calidad de las aguas. Este indicador solo se ha analizado sobre aguas subterráneas. Los valores de cambio vendrán definidos por los identificados en la siguiente tabla, según la concentración de cloruros.
            En este análisis se han considerado todas analíticas de sustancias de cloruros disponibles en los Programas de Seguimiento (programa de control de vigilancia y operativo) de aguas subterráneas previstos para evaluar el estado, en cumplimiento de la normativa estatal y europea, de las que se dispone de información en NABIA (Sistema de intercambio de información sobre el estado y calidad de las aguas).</dct:description>
    <dct:identifier>32b1ecd2-487e-445e-9276-e97c6bb8e439</dct:identifier>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-22</dct:issued>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
    <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002"/>
    <dct:spatial>
      <dct:Location>
        <dcat:bbox rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POLYGON((-9.75 35.00, 4.57 35.00, 4.57 44.04, -9.75 44.04, -9.75 35.00))</dcat:bbox>
      </dct:Location>
    </dct:spatial>
