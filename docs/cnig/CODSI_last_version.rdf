      </vcard:Organization>
    </dcat:contactPoint>
    <dcat:distribution rdf:resource="https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesPadron/formatters/html"/>
    <dcat:distribution rdf:resource="https://www.idee.es/csw-codsi-idee/srv/api/records/spaINE_SeccionesPadron/formatters/xml"/>
    <dcat:keyword xml:lang="es">España</dcat:keyword>
    <dcat:keyword xml:lang="es">INE</dcat:keyword>
    <dcat:keyword xml:lang="es">Nacional</dcat:keyword>
    <dcat:keyword xml:lang="es">Unidades estadísticas</dcat:keyword>
    <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/demografia"/>
    <dcat:theme rdf:resource="http://inspire.ec.europa.eu/theme/su"/>
    <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg_impl/2023/138/oj"/>
    <dcatap:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2008/1205/oj"/>
    <dcatap:hvdCategory rdf:resource="http://data.europa.eu/bna/c_ac64a52d"/>
    <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
    <dct:conformsTo rdf:resource="https://datosgobes.github.io/DCAT-AP-ES"/>
    <dct:description xml:lang="es">Serie anual del Censo de Población y Viviendas 2001 correspondientes al Censo Electoral (CE) y Padrón Municipal de Habitantes (PA). Se añade el seccionado de los Censos de Población y Viviendas 2001 (CPV) a fecha oficial de su recogida, 1 de Noviembre. Los elementos de cada serie son dos: únicamente Distritos y, dentro de los mismos, Secciones. La delimitación territorial de las Secciones Censales establece el ámbito de esta unidad estadística inferior al municipio que es la base de la mayoría de las operaciones estadísticas del Sistema Estadístico Nacional: censos, padrones, encuestas y otras operaciones estadísticas. Todo municipio se divide en una o más Secciones Censales y no hay ninguna parte del municipio que no pertenezca a una Sección Censal. Las secciones de un municipio se agrupan en uno o más Distritos Censales y toda Sección pertenece a un Distrito Censal. La serie arranca a partir del año 2007, a 1 de enero para cada año, incluyendo además las fechas censales, como el 1 noviembre para los años 2001. Escala mínima de visibilidad: 1:1.000.000 para Distrito y 1:250.000 para Sección Censal.</dct:description>
    <dct:identifier>spaINE_SeccionesPadron</dct:identifier>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2001-11-01</dct:issued>
    <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
    <dct:publisher rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0002"/>
    <dct:spatial>
      <dct:Location>
        <dcat:bbox rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POLYGON((-19.00 27.60, 4.31 27.60, 4.31 44.00, -19.00 44.00, -19.00 27.60))</dcat:bbox>
      </dct:Location>
    </dct:spatial>
    <dct:title xml:lang="es">Secciones Censo Población y Viviendas 2001 de España</dct:title>
    <dct:title xml:lang="en">Sections of the 2001 Population and Housing Census of Spain</dct:title>
    <dct:type rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"/>
    <foaf:page rdf:resource="http://data.europa.eu/eli/reg_impl/2023/138/oj"/>
    <foaf:page rdf:resource="http://data.europa.eu/eli/reg/2008/1205/oj"/>
  </dcat:Dataset>
