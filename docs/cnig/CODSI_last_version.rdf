      </dct:Location>
    </dct:spatial>
    <dct:temporal>
      <dct:PeriodOfTime>
        <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-10-11</dcat:endDate>
        <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2008-02-08</dcat:startDate>
      </dct:PeriodOfTime>
    </dct:temporal>
    <dct:title xml:lang="es">Modelo Digital del Terreno (MDT) de 1m de la Comunidad Autónoma del País Vasco. Año 2017.</dct:title>
