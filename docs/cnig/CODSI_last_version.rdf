  <dcat:Dataset rdf:about="https://www.idee.es/csw-codsi-idee/srv/api/records/66b2b8b6-7733-4a2c-bab1-ee092cfd6bb1">
    <adms:identifier rdf:resource="https://www.idee.es/csw-codsi-idee/srv/spa/catalog.search#/metadata/66b2b8b6-7733-4a2c-bab1-ee092cfd6bb1"/>
