        <dcat:bbox rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POLYGON((-19.00 27.60, 4.30 27.60, 4.30 44.00, -19.00 44.00, -19.00 27.60))</dcat:bbox>
